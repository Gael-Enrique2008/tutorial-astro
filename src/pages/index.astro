---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const pageTitle = "Página de inicio";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
  </head>

  <body>
    <Header />

    <main>
      <h1>Mi sitio Astro</h1>

      <p>
        Bienvenido a mi primer sitio web creado con Astro.
      </p>

      <p>
        En este proyecto estoy aprendiendo a crear páginas,
        utilizar Markdown y agregar contenido dinámico.
      </p>
    </main>

    <Footer />
  </body>
</html>