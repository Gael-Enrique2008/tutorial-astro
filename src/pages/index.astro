---
import BaseLayout from '../layouts/BaseLayout.astro';
import Greeting from '../components/Greeting';

const pageTitle = "Página de inicio";
---

<BaseLayout pageTitle={pageTitle}>

  <h2>Mi impresionante subtítulo del blog</h2>

  <p>
    Bienvenido a mi primer sitio web creado con Astro.
  </p>

  <p>
    En este proyecto estoy aprendiendo a crear páginas,
    utilizar Markdown, componentes y layouts.
  </p>

  <Greeting
    client:load
    messages={["Hej", "Hallo", "Hola", "Habari"]}
  />

</BaseLayout>