---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Sobre mí";

const identity = {
  firstName: "Gael",
  country: "México",
  occupation: "Estudiante de Desarrollo de Software",
  hobbies: ["plantas", "videojuegos"],
};

const skills = [
  "C",
  "C++",
  "C#",
  "JavaScript",
  "React",
  "Astro",
];

const happy = true;
const finished = true;
const goal = 3;

const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase";
---

<BaseLayout pageTitle={pageTitle}>

  <style
    is:global
    define:vars={{ skillColor, fontWeight, textCase }}
  >
    .skill {
      color: var(--skillColor);
      font-weight: var(--fontWeight);
      text-transform: var(--textCase);
    }

    h1 {
      color: purple;
      font-size: 4rem;
    }
  </style>

  <p>
    Estos son algunos datos sobre mí:
  </p>

  <ul>
    <li>
      Me llamo {identity.firstName}.
    </li>

    <li>
      Vivo en {identity.country} y soy
      {identity.occupation}.
    </li>

    {
      identity.hobbies.length >= 2 && (
        <li>
          Dos de mis aficiones son:
          {identity.hobbies[0]} y {identity.hobbies[1]}.
        </li>
      )
    }
  </ul>

  <h2>Mis habilidades</h2>

  <ul>
    {
      skills.map((skill) => (
        <li class="skill">{skill}</li>
      ))
    }
  </ul>

  <h2>Mi progreso</h2>

  {happy && (
    <p>¡Estoy feliz de aprender Astro!</p>
  )}

  {finished && (
    <p>¡He terminado este tutorial!</p>
  )}

  {
    goal === 3
      ? <p>Mi objetivo es terminar en 3 horas.</p>
      : <p>Mi objetivo no son 3 días.</p>
  }

</BaseLayout>